{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DesktopTodoSpike",
  "version": "0.1.0",
  "identifier": "com.zwxdogs.desktoptodospike",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "桌面待办 spike",
        "width": 380,
        "height": 640,
        "create": false,
        "minWidth": 260,
        "minHeight": 180,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
