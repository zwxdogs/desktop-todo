{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DesktopTodo",
  "version": "0.3.0",
  "identifier": "com.zwxdogs.desktoptodo",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "桌面待办",
        "create": false,
        "minWidth": 260,
